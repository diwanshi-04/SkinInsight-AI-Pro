# Copy to .env.local for local dev; add the same names in Vercel > Settings > Environment Variables

# URL of your deployed Python backend (Railway/Render/etc). Local default: http://127.0.0.1:5001
ML_SERVER_URL=http://127.0.0.1:5001

# AI Doctor chat (Groq)
GROQ_API_KEY=
GROQ_MODEL=

# Auth
AUTH_SECRET=

# Google login (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your own public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_URL=http://localhost:3000
